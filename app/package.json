{
  "name": "barnaby",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build.ps1",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "description": "A patient voice helper for older adults using a Windows computer",
  "author": "Seam Engine",
  "build": {
    "appId": "com.hellobarnaby.app",
    "productName": "Barnaby",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "ui/**/*",
      "!test/**",
      "!native/**"
    ],
    "extraResources": [
      {
        "from": "native/bin/helper.exe",
        "to": "native/helper.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.exe"
    }
  }
}